#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl

write_files:
  - path: /etc/systemd/system/${app_name}.service
    permissions: '0644'
    content: |
      [Unit]
      Description=${app_name} web application container
      After=docker.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f ${app_name}
      ExecStartPre=/usr/bin/docker pull ${container_image}
      ExecStart=/usr/bin/docker run --rm --name ${app_name} \
        --pull always \
        -p ${http_port}:${container_port} \
        ${env_flags} \
        ${container_image}
      ExecStop=/usr/bin/docker stop ${app_name}

      [Install]
      WantedBy=multi-user.target

runcmd:
  - curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
  - sh /tmp/get-docker.sh
  - systemctl enable --now docker
  - systemctl daemon-reload
  - systemctl enable --now ${app_name}.service
