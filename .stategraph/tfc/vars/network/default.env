# Environment of Terraform Cloud workspace sg-migration-e2e-network.
export SG_E2E_PLAIN='it'"'"'s plain'
export TF_VAR_extra='from-env'
export TF_VAR_secret_env="${TFC_SG_MIGRATION_E2E_NETWORK__TF_VAR_SECRET_ENV:?the GitHub secret TFC_SG_MIGRATION_E2E_NETWORK__TF_VAR_SECRET_ENV is not set}"
__sg_tfvars="${TERRATEAM_TMPDIR:-/tmp}/tfc-sensitive.tfvars"
: > "$__sg_tfvars"
: "${TFC_SG_MIGRATION_E2E_NETWORK__DB_PASSWORD:?the GitHub secret TFC_SG_MIGRATION_E2E_NETWORK__DB_PASSWORD is not set}"
printf '%s = %s\n' db_password "$(python3 -c 'import json, os, sys; print(json.dumps(os.environ[sys.argv[1]]).replace("${", "$${").replace("%{", "%%{"))' TFC_SG_MIGRATION_E2E_NETWORK__DB_PASSWORD)" >> "$__sg_tfvars"
