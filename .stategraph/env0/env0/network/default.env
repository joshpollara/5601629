# Environment of env0 environment sg-migration-e2e-network.
export ENV0_ENVIRONMENT_NAME='sg-migration-e2e-network'
export ENV0_WORKSPACE_NAME='sg-e2e-network'
export TF_VAR_api_token="${ENV0_SG_MIGRATION_E2E_NETWORK__TF_VAR_API_TOKEN:?the GitHub secret ENV0_SG_MIGRATION_E2E_NETWORK__TF_VAR_API_TOKEN is not set}"
__sg_tfvars="${TERRATEAM_TMPDIR:-/tmp}/env0-sensitive.tfvars"
: > "$__sg_tfvars"
: "${ENV0_SG_MIGRATION_E2E_NETWORK__DB_PASSWORD:?the GitHub secret ENV0_SG_MIGRATION_E2E_NETWORK__DB_PASSWORD is not set}"
printf '%s = %s\n' db_password "$(python3 -c 'import json, os, sys; print(json.dumps(os.environ[sys.argv[1]]).replace("${", "$${").replace("%{", "%%{"))' ENV0_SG_MIGRATION_E2E_NETWORK__DB_PASSWORD)" >> "$__sg_tfvars"
