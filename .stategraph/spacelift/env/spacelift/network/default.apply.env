# Environment of Spacelift stack sg-migration-e2e-network for applies.
export SPACELIFT_WORKSPACE_ROOT="${SPACELIFT_WORKSPACE_ROOT:-${TERRATEAM_ROOT}/.stategraph/spacelift/workspace/sg-migration-e2e-network}"
mkdir -p "$SPACELIFT_WORKSPACE_ROOT"
export TF_VAR_spacelift_stack_id='sg-migration-e2e-network'
export TF_VAR_cidr='10.0.0.0/16'
export TF_VAR_config_path="${SPACELIFT_WORKSPACE_ROOT}/config.json"
export TF_VAR_db_password="${SPACELIFT_SG_MIGRATION_E2E_NETWORK__TF_VAR_DB_PASSWORD:?the GitHub secret SPACELIFT_SG_MIGRATION_E2E_NETWORK__TF_VAR_DB_PASSWORD is not set}"
export TF_VAR_note="it's ${TF_VAR_cidr}"
mkdir -p "$(dirname "$SPACELIFT_WORKSPACE_ROOT"/'config.json')"
cp "${TERRATEAM_ROOT}"/'.stategraph/spacelift/files/sg-migration-e2e-network/config.json' "$SPACELIFT_WORKSPACE_ROOT"/'config.json'
mkdir -p "$(dirname "$SPACELIFT_WORKSPACE_ROOT"/'secret.txt')"
printf %s "${SPACELIFT_SG_MIGRATION_E2E_NETWORK__SECRET_TXT:?the GitHub secret SPACELIFT_SG_MIGRATION_E2E_NETWORK__SECRET_TXT is not set}" | base64 -d > "$SPACELIFT_WORKSPACE_ROOT"/'secret.txt'
